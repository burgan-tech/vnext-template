            "label": "Failed"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      },
      {
        "key": "exhausted",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Exhausted"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
